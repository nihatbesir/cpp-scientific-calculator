#include <iostream>
#include <cmath>

using namespace std;

// M_PI xətasının qarşısını almaq üçün sabit pi tərifi
const double PI = acos(-1.0);

class Calculator {
public:

    double add(double a, double b) { return a + b; }

    double subtract(double a, double b) { return a - b; }

    double multiply(double a, double b) { return a * b; }

    double divide(double a, double b) {
        if (b == 0) {
            cout << "Xəta: 0-a bölmə yoxdur!\n";
            return 0;
        }
        return a / b;
    }

    double percentage(double a, double b) {
        return (a * b) / 100;
    }

    double squareRoot(double a) {
        if (a < 0) {
            cout << "Xəta: Mənfi ədədin kvadrat kökü yoxdur!\n";
            return 0;
        }
        return sqrt(a);
    }

    double power(double a, double b) {
        return pow(a, b);
    }

    double sine(double a) {
        return sin(a * PI / 180.0); // Dərəcə ilə
    }

    double cosine(double a) {
        return cos(a * PI / 180.0);
    }

    double tangent(double a) {
        // 90, 270, 450 kimi dərəcələrdə tan təyin olunmayıb
        if (fmod(a, 180.0) == 90.0 || fmod(a, 180.0) == -90.0) {
            cout << "Xəta: Tangens bu dərəcədə təyin olunmayıb!\n";
            return 0;
        }
        return tan(a * PI / 180.0);
    }

    double log10calc(double a) {
        if (a <= 0) {
            cout << "Xəta: Logarifm üçün ədəd 0-dan böyük olmalıdır!\n";
            return 0;
        }
        return log10(a);
    }

    double ln(double a) {
        if (a <= 0) {
            cout << "Xəta: ln üçün ədəd 0-dan böyük olmalıdır!\n";
            return 0;
        }
        return log(a);
    }

    double factorial(int n) {
        if (n < 0) {
            cout << "Xəta: Mənfi ədədin faktorialı yoxdur!\n";
            return -1;
        }
        double result = 1;
        for (int i = 1; i <= n; i++)
            result *= i;
        return result;
    }
};

int main() {

    Calculator calc;
    int choice;
    double a, b;
    int n; // Faktorial üçün tam ədəd

    do {
        cout << "\n===== OOP SCIENTIFIC CALCULATOR =====\n";
        cout << "1. +\n2. -\n3. *\n4. /\n5. %\n6. sqrt\n7. x^y\n";
        cout << "8. sin\n9. cos\n10. tan\n11. log10\n12. ln\n13. factorial\n0. Çıxış\n";
        cout << "Seçim edin: ";
        cin >> choice;

        switch(choice) {

            case 1: 
                cout << "İki ədəd daxil edin: "; cin >> a >> b; 
                cout << "Nəticə: " << calc.add(a,b) << "\n"; break;
            case 2: 
                cout << "İki ədəd daxil edin: "; cin >> a >> b; 
                cout << "Nəticə: " << calc.subtract(a,b) << "\n"; break;
            case 3: 
                cout << "İki ədəd daxil edin: "; cin >> a >> b; 
                cout << "Nəticə: " << calc.multiply(a,b) << "\n"; break;
            case 4: 
                cout << "Bölünən və böləni daxil edin: "; cin >> a >> b; 
                cout << "Nəticə: " << calc.divide(a,b) << "\n"; break;
            case 5: 
                cout << "Ədəd və faizi daxil edin: "; cin >> a >> b; 
                cout << "Nəticə: " << calc.percentage(a,b) << "\n"; break;
            case 6: 
                cout << "Ədəd daxil edin: "; cin >> a; 
                cout << "Nəticə: " << calc.squareRoot(a) << "\n"; break;
            case 7: 
                cout << "Əsas və üstü daxil edin: "; cin >> a >> b; 
                cout << "Nəticə: " << calc.power(a,b) << "\n"; break;
            case 8: 
                cout << "Dərəcəni daxil edin: "; cin >> a; 
                cout << "Nəticə: " << calc.sine(a) << "\n"; break;
            case 9: 
                cout << "Dərəcəni daxil edin: "; cin >> a; 
                cout << "Nəticə: " << calc.cosine(a) << "\n"; break;
            case 10: 
                cout << "Dərəcəni daxil edin: "; cin >> a; 
                cout << "Nəticə: " << calc.tangent(a) << "\n"; break;
            case 11: 
                cout << "Ədəd daxil edin: "; cin >> a; 
                cout << "Nəticə: " << calc.log10calc(a) << "\n"; break;
            case 12: 
                cout << "Ədəd daxil edin: "; cin >> a; 
                cout << "Nəticə: " << calc.ln(a) << "\n"; break;
            case 13: 
                cout << "Tam ədəd daxil edin: "; cin >> n; 
                cout << "Nəticə: " << calc.factorial(n) << "\n"; break;
            case 0: 
                cout << "Proqram bağlandı.\n"; break;
            default: 
                cout << "Yanlış seçim! Yenidən cəhd edin.\n";
        }

    } while(choice != 0);

    return 0;
}
